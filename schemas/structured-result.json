{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestra.dev/schemas/structured-result.json",
  "title": "OrchestraStructuredResult",
  "description": "Structured output contract returned by Orchestra specialist agents.",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "step_id",
    "agent_role",
    "status",
    "summary",
    "changed_files",
    "verification_evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "task_id": { "type": "string" },
    "step_id": { "type": "string" },
    "agent_role": {
      "type": "string",
      "enum": ["orchestra", "researcher", "advisor", "tester", "reviewer", "worker"]
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "failed", "escalate"]
    },
    "summary": {
      "type": "string",
      "minLength": 5
    },
    "changed_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tests_run": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "exit_code"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "exit_code": { "type": "integer" },
          "passed": { "type": "integer", "minimum": 0 },
          "failed": { "type": "integer", "minimum": 0 },
          "output_snippet": { "type": "string" }
        }
      }
    },
    "verification_evidence": {
      "type": "string",
      "minLength": 5
    },
    "unresolved_risks": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "token_usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
