{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestra.dev/schemas/verification-report.json",
  "title": "OrchestraVerificationReport",
  "description": "Structured empirical completion evidence format.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "tier",
    "target_changes",
    "automated_tests",
    "lint_status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": ["PASSED", "FAILED"]
    },
    "tier": {
      "type": "string",
      "enum": ["Tiny", "Normal", "Complex", "Architectural"]
    },
    "target_changes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "automated_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "exit_code"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "exit_code": { "type": "integer" },
          "output_snippet": { "type": "string" }
        }
      },
      "minItems": 1
    },
    "lint_status": {
      "type": "object",
      "required": ["command", "exit_code"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string" },
        "exit_code": { "type": "integer" },
        "clean": { "type": "boolean", "default": true }
      }
    },
    "unverified_surfaces": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}
